---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const poems = await getCollection('poems');
  return poems.map((p) => ({
    params: { slug: p.id },
    props: { poem: p },
  }));
}

const { poem } = Astro.props;
const { Content } = await render(poem);
const base = import.meta.env.BASE_URL;
const canonical = new URL(`/siirler/${poem.id}/`, Astro.site).href;
const coverUrl = poem.data.cover
  ? new URL(poem.data.cover.replace(/^\//, ''), Astro.site).href
  : undefined;

const fmt = (d: Date) =>
  d.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });

// CreativeWork schema
const poemJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: poem.data.title,
  description: poem.data.description,
  ...(coverUrl ? { image: coverUrl } : {}),
  inLanguage: 'tr',
  datePublished: poem.data.date.toISOString(),
  author: { '@type': 'Person', name: 'İlker Halil Türer' },
  url: canonical,
};
---

<BaseLayout
  title={poem.data.title}
  description={poem.data.description}
  type="article"
  date={poem.data.date}
  canonical={canonical}
  image={poem.data.cover || undefined}
  jsonLd={[poemJsonLd]}
>
  <article class="poem-article">
    <div class="container">
      <header class="poem-header">
        <div class="poem-cover-wrap">
          {poem.data.cover && (
            <img
              src={`${base}${poem.data.cover.replace(/^\//, '')}`}
              alt={poem.data.title}
              class="poem-cover"
              loading="eager"
            />
          )}
        </div>
        <div class="poem-heading">
          <p class="poem-kicker">Şiir</p>
          <h1>{poem.data.title}</h1>
          <div class="meta">{fmt(poem.data.date)}</div>
        </div>
      </header>
      <div class="poem-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .poem-article { padding: var(--space-xl) 0 var(--space-2xl); }
  .poem-header {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-xl);
    align-items: center;
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-xl);
  }
  .poem-cover-wrap {
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 3/4;
  }
  .poem-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
  .poem-kicker {
    font-family: var(--display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }
  .poem-heading h1 {
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }
  .poem-heading .meta { color: var(--ink-soft); font-size: 0.8125rem; }
  .poem-body {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 2;
    max-width: 32rem;
    margin: 0 auto;
    text-align: left;
  }
  @media (max-width: 768px) {
    .poem-header { grid-template-columns: 1fr; text-align: center; gap: var(--space-md); }
    .poem-cover-wrap { max-width: 220px; margin: 0 auto; }
  }
</style>
