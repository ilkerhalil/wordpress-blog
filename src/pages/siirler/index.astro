---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const poems = (await getCollection('poems')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL;

const fmt = (d: Date) =>
  d.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Şiirler"
  description="İlker Halil Türer'in şiirleri — 29 şiir."
>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1 class="page-title">Şiirler</h1>
        <p class="page-sub">{poems.length} şiir</p>
      </header>
      <div class="poem-grid">
        {poems.map((p) => (
          <a class="poem-card" href={`${base}siirler/${p.id}/`}>
            {p.data.cover && (
              <div class="poem-thumb">
                <img
                  src={`${base}${p.data.cover.replace(/^\//, '')}`}
                  alt={p.data.title}
                  loading="lazy"
                />
              </div>
            )}
            <div class="poem-info">
              <h3>{p.data.title}</h3>
              <div class="meta">{fmt(p.data.date)}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { margin-bottom: 2rem; }
  .page-title {
    font-family: var(--display);
    font-size: 2.4rem;
    margin-bottom: 0.3rem;
  }
  .page-sub { color: var(--ink-soft); }

  .poem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }
  .poem-card {
    text-decoration: none;
    color: var(--ink);
    display: block;
  }
  .poem-thumb {
    aspect-ratio: 3/4;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.7rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .poem-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .poem-card:hover .poem-thumb {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .poem-info h3 {
    font-family: var(--display);
    font-size: 1.05rem;
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }
  .poem-info .meta { font-size: 0.8rem; color: var(--ink-soft); }

  @media (max-width: 480px) {
    .poem-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
</style>
