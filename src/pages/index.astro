---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const books = (await getCollection('books')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const poems = (await getCollection('poems')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL;

const recentBooks = books.slice(0, 4);
const recentPoems = poems.slice(0, 8);

const fmt = (d: Date) =>
  d.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="hero-kicker">{SITE.tagline}</p>
      <h1>{SITE.author}</h1>
      <p class="lead">
        Okuduklarım üzerine notlar, yazdıklarım üzerine satırlar.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Son Şiirler</h2>
      <div class="poem-grid">
        {recentPoems.map((p) => (
          <a class="poem-card" href={`${base}siirler/${p.id}/`}>
            {p.data.cover && (
              <div class="poem-thumb">
                <img
                  src={`${base}${p.data.cover.replace(/^\//, '')}`}
                  alt={p.data.title}
                  loading="lazy"
                />
              </div>
            )}
            <div class="poem-info">
              <h3>{p.data.title}</h3>
              <div class="meta">{fmt(p.data.date)}</div>
            </div>
          </a>
        ))}
      </div>
      <p class="more-link"><a href={`${base}siirler/`}>Tüm şiirler →</a></p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Son Kitap İncelemeleri</h2>
      <div class="book-list">
        {recentBooks.map((b) => (
          <a class="book-card" href={`${base}kitaplar/${b.id}/`}>
            <div class="book-num">{String(books.length - books.indexOf(b)).padStart(2, '0')}</div>
            <div class="book-body">
              <h3>{b.data.title}</h3>
              <div class="meta">{fmt(b.data.date)}</div>
            </div>
          </a>
        ))}
      </div>
      <p class="more-link"><a href={`${base}kitaplar/`}>Tüm incelemeler →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 3.5rem;
    text-align: center;
    position: relative;
  }
  .hero-kicker {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-family: var(--display);
    font-size: clamp(2.6rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }
  .hero .lead {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 30rem;
    margin: 0 auto;
  }

  .section-alt { background: var(--bg-alt); }

  .poem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .poem-card { text-decoration: none; color: var(--ink); display: block; }
  .poem-thumb {
    aspect-ratio: 3/4;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.7rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .poem-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .poem-card:hover .poem-thumb {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .poem-info h3 { font-family: var(--display); font-size: 1.05rem; line-height: 1.3; margin-bottom: 0.2rem; }
  .poem-info .meta { font-size: 0.8rem; color: var(--ink-soft); }

  .book-list { display: grid; gap: 0.8rem; }
  .book-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.2rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.12s, box-shadow 0.12s, border-color 0.12s;
  }
  .book-card:hover {
    transform: translateX(4px);
    border-color: var(--accent-soft);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .book-num {
    font-family: var(--display);
    font-size: 1.4rem;
    color: var(--accent);
    min-width: 2.2rem;
    text-align: center;
  }
  .book-body h3 { font-family: var(--display); font-size: 1.1rem; line-height: 1.3; margin-bottom: 0.2rem; }
  .book-body .meta { font-size: 0.85rem; color: var(--ink-soft); }

  .more-link { margin-top: 1.5rem; }
  .more-link a { color: var(--accent); text-decoration: none; font-weight: 500; }
  .more-link a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .poem-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .poem-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
</style>
